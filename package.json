{
  "name": "rsvp-plataforma", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "wrangler dev", "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs", "check": "node scripts/check.mjs",
    "validate": "node scripts/check.mjs && node --test tests/*.test.mjs && node scripts/build.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/guard-deploy.mjs && wrangler deploy"
  },
  "dependencies": { "@simplewebauthn/server": "13.2.2", "@simplewebauthn/browser": "13.2.2", "qrcode": "1.5.4" },
  "devDependencies": { "esbuild": "0.28.2", "wrangler": "4.147.0" },
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13" }
}
